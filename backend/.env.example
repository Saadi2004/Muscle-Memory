# Google Gemini API Key (Required for live AI reasoning; falls back to deterministic simulation engine if empty)
GEMINI_API_KEY=

# Google Cloud Project Configuration (Optional for Firestore cloud sync; falls back to local JSON memory)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Slack Webhook URL (Optional for posting alerts to live Slack channel; falls back to UI event stream)
SLACK_WEBHOOK_URL=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
